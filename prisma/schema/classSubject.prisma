
enum CourseOfferStatus {
  planned
  open
  closed
  cancelled
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ==========================
// 8. ClassSubject (Bảng trung gian giữa môn học và lớp học --> để phân giáo viên)
// ==========================
model CourseOffer {
  id                Int       @id @default(autoincrement())
  teacherId         Int?
  teacher           Staff?    @relation(fields: [teacherId], references: [id])
  subjectId         Int
  subject           Subject   @relation(fields: [subjectId], references: [id])
  classId           Int?
  baseClass         Class?    @relation(fields: [classId], references: [id])
  semesterId        Int
  semester          Semester  @relation(fields: [semesterId], references: [id])
  
  // planned, open, closed, cancelled
  // status            CourseOfferStatus? @default(planned)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt  

  // Quan hệ
  registrations          CourseRegistration[]
  classSubjectSessions   ClassSubjectSession[]

  @@unique([subjectId, classId])
  @@index([subjectId, semesterId])
  @@index([teacherId])
  @@index([semesterId])
  @@index([classId])
  @@map("course_offers")
}

// ==========================
// Điểm của 1 học sinh của 1 classSubject
// Bảng này là: Grades
// ==========================
model CourseRegistration {
  id             Int         @id @default(autoincrement())
  
  studentId      Int
  student        Student     @relation(fields: [studentId], references: [id])
  
  courseOfferId  Int
  courseOffer    CourseOffer @relation(fields: [courseOfferId], references: [id])
  
  kttx1           Float?
  kttx2           Float?
  kttx3           Float?
  ktdk1           Float?
  ktdk2           Float?
  ktdk3           Float?
  ktdk4           Float?
  diemTB          Float?
  diemKiemTra1    Float?
  diemKiemTra2    Float?
  diemTongKet1    Float?
  diemTongKet2    Float?
  rating          String?

  note           String?     @db.Text
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([studentId, courseOfferId])
  @@map("course_registrations")
}

// ==========================
// 10a. CLASS_SUBJECT_SESSION (BUỔI HỌC ĐỊNH KỲ)
// ==========================
// Định nghĩa 1 "buổi học" cố định trong tuần của 1 lớp học phần
// VD: Lớp X học Thứ 2, tiết 2-4, buổi Sáng
model ClassSubjectSession {
  id              Int         @id @default(autoincrement())
  classSubjectId  Int
  classSubject    CourseOffer @relation(fields: [classSubjectId], references: [id])

  dayOfWeek       DayOfWeek   // 2 -> 8 (Thứ 2 đến Chủ Nhật)
  shift           String      // S - C - T: sáng - chiều - tối
  startPeriod     Int         // Tiết bắt đầu: 2
  endPeriod       Int         // Tiết kết thúc: 4
  countPeriod     Int?        // Số tiết: 4 - 2 + 1 = 3

  roomId          Int?        // Phòng học mặc định cho buổi này
  room            Room?       @relation(fields: [roomId], references: [id])

  schedules       ClassSubjectScheduleDetail[]

  @@unique([classSubjectId, dayOfWeek, shift, startPeriod, endPeriod])
  @@map("class_subject_session")
}

// Mỗi record là 1 lần học cụ thể (theo tuần/ngày) của 1 buổi học định kỳ
// Cho phép override phòng học nếu buổi đó đổi phòng
model ClassSubjectScheduleDetail {
  id          Int                  @id @default(autoincrement())
  sessionId   Int
  session     ClassSubjectSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  weekNumber  Int
  studyDate   DateTime?            @db.Date() // Ngày học cụ thể

  roomId      Int?                 // Ghi đè phòng học nếu buổi đó học phòng khác
  room        Room?                @relation(fields: [roomId], references: [id])

  @@unique([sessionId, weekNumber])
  @@map("class_subject_schedule_detail")
}

model TeacherSubject {
  id        Int @id @default(autoincrement())

  teacherId Int
  subjectId Int

  teacher   Staff   @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}