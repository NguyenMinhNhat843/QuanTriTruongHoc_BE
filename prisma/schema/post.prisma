enum PostType {
  NEWS
  ADMISSION
  EVENT
  INTERNAL
  ACHIEVEMENT
  MENU
  RECRUITMENT
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model Post {
  id         Int     @id @default(autoincrement())
  title      String
  slug       String  @unique
  coverImage String?
  summary    String? @db.VarChar(500) // Tóm tắt hiển thị ở danh sách bài viết
  content    String  @db.Text

  // SEO Optimization
  seoTitle       String?
  seoDescription String?

  type   PostType   @default(NEWS)
  status PostStatus @default(DRAFT)

  // Thời điểm hiển thị công khai (Dùng cho cả bài đăng ngay và hẹn giờ)
  publishedAt DateTime?

  viewCount Int  @default(0)
  authorId  Int
  author    User @relation(fields: [authorId], references: [id])

  // Quản lý ảnh đi kèm bài viết
  images FileStore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type, publishedAt])
}

model FileStore {
  id       String  @id @default(uuid())
  imageUrl String
  publicId String  @unique
  isUsed   Boolean @default(false)

  // Quan hệ với bài viết
  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
