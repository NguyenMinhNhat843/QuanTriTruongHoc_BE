// ==========================================
// TUYỂN SINH — ĐỢT & NGÀNH & CHỈ TIÊU
// ==========================================
enum CampaignStatus {
  PLANNING   // Lập kế hoạch (chưa mở)
  OPEN       // Đang nhận hồ sơ
  CLOSED     // Đã hết hạn nhận hồ sơ
  COMPLETED  // Đã hoàn tất công tác tuyển sinh đợt này
}

// Đợt tuyển sinh — KHÔNG gắn cứng với 1 hệ đào tạo cụ thể.
// Một đợt có thể tuyển nhiều ngành, mỗi ngành lại mở nhiều hệ đào tạo khác nhau
// (xem AdmissionCampaignMajor). Muốn tuyển sơ cấp riêng hàng tháng thì tạo
// nhiều AdmissionCampaign với khoảng thời gian ngắn, tách biệt các đợt lớn (9+/TC).
model AdmissionCampaign {
  id            Int            @id @default(autoincrement())
  code          String         @unique // "D1-2026"
  name          String         // "Tuyển sinh Đợt 1 - Năm 2026"

  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  status        CampaignStatus @default(PLANNING)
 
  description   String?

  academicYearId Int
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  // Restrict thay vì Cascade: dữ liệu tuyển sinh phải lưu vĩnh viễn theo quy chế lưu trữ,
  // không cho xóa năm học kéo theo xóa toàn bộ hồ sơ tuyển sinh liên quan.

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaignMajors  AdmissionCampaignMajor[]
  documentConfigs DocumentConfig[]

  @@map("admission_campaigns")
}

// Cách tính điểm học bạ: lấy điểm/hạnh kiểm năm cuối, hay trung bình cả giai đoạn
enum TranscriptScoreMethod {
  LAST_YEAR_ONLY     // chỉ lấy điểm lớp 9 (hoặc lớp 12)
  AVERAGE_ALL_YEARS  // trung bình các năm (6-9 hoặc 10-12)
}

// Cấu hình tuyển sinh cho 1 Ngành + 1 Hệ đào tạo, trong 1 Đợt cụ thể.
// Đây là bảng trung tâm: mọi tiêu chí xét tuyển (chỉ tiêu, phương thức chấp nhận,
// tổ hợp môn, điểm sàn, điểm chuẩn...) đều cấu hình ở cấp này, KHÔNG ở cấp Campaign,
// vì cùng 1 ngành có thể có yêu cầu khác nhau giữa các hệ đào tạo trong cùng 1 đợt.
model AdmissionCampaignMajor {
  id                  Int               @id @default(autoincrement())
  admissionCampaignId Int
  majorId             Int
  trainingType        TrainingType      // 9+, sơ cấp, trung cấp, thường xuyên

  quota               Int

  // --- Phương thức xét tuyển được chấp nhận cho ngành/hệ này trong đợt này ---
  acceptedAdmissionTypes AdmissionType[]

  // --- Nhánh 1: xét theo tổ hợp 3 môn (điểm thi hoặc học bạ theo môn) ---
  subjectCombinationId Int?
  subjectCombination   SubjectCombination? @relation(fields: [subjectCombinationId], references: [id])
  minScorePerSubject    Float?             // điểm sàn từng môn (chống liệt)
  minTotalScore         Float?             // điểm sàn tổng 3 môn

  // --- Nhánh 2: xét học bạ theo điểm TB chung + hạnh kiểm ---
  minGpaAverage         Float?             // ngưỡng điểm TB chung (theo transcriptScoreMethod)
  minConduct            Conduct?           // hạnh kiểm tối thiểu, áp dụng cho MỌI năm trong phạm vi xét

  // --- Dùng chung cho cả 2 nhánh xét học bạ ---
  transcriptScoreMethod TranscriptScoreMethod?

  cutoffScore           Float?             // điểm chuẩn — set sau khi duyệt hồ sơ, dùng để tự động APPROVE/REJECT

  admissionCampaign   AdmissionCampaign @relation(fields: [admissionCampaignId], references: [id], onDelete: Cascade)
  major               Major             @relation(fields: [majorId], references: [id])

  admissionProfiles   AdmissionProfile[]

  @@unique([admissionCampaignId, majorId, trainingType])
  @@map("admission_campaign_majors")
}

// ==========================================
// TỔ HỢP MÔN XÉT TUYỂN
// ==========================================
model SubjectCombination {
  id    Int                      @id @default(autoincrement())
  code  String                   @unique // "A", "A1", "D01"
  name  String                   // "Toán - Lý - Hóa"

  items                  SubjectCombinationItem[]
  admissionCampaignMajors AdmissionCampaignMajor[]
  admissionProfiles       AdmissionProfile[]

  @@map("subject_combinations")
}

model SubjectCombinationItem {
  id                   Int                @id @default(autoincrement())
  subjectCombinationId Int
  subjectCode          String             // MATH, LITERATURE, ENGLISH, PHYSICS, CHEMISTRY, BIOLOGY...

  subjectCombination   SubjectCombination @relation(fields: [subjectCombinationId], references: [id], onDelete: Cascade)

  @@unique([subjectCombinationId, subjectCode])
  @@map("subject_combination_items")
}

// ==========================================
// TRẠNG THÁI HỒ SƠ ĐĂNG KÝ
// ==========================================
enum ApplicationStatus {
  REGISTERED // Mới đăng ký online
  SUBMITTED  // Đã nộp đủ hồ sơ số hóa, chờ duyệt
  APPROVED   // Đã trúng tuyển (đủ điều kiện học lực), chờ xác nhận nhập học
  CONFIRMED  // Thí sinh đã xác nhận nhập học / đóng phí giữ chỗ — hồ sơ giấy CHƯA chắc đã đối chiếu xong
  REJECTED   // Rớt / hồ sơ không hợp lệ
  ENROLLED   // Đã đối chiếu hồ sơ giấy đầy đủ & hợp lệ — TẠI ĐÂY mới tạo Student + User
  CANCELLED  // Thí sinh tự hủy đăng ký
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Hạnh kiểm — thứ tự khai báo có ý nghĩa: TOT > KHA > TB > YEU, dùng để so sánh
// với minConduct ở tầng ứng dụng (ánh xạ TOT=4, KHA=3, TB=2, YEU=1)
enum Conduct {
  TOT
  KHA
  TB
  YEU
}

// Khu vực ưu tiên theo quy chế tuyển sinh (KV1, KV2-NT, KV2, KV3)
enum PriorityRegion {
  KV1
  KV2_NT
  KV2
  KV3
}

// Đối tượng ưu tiên theo quy chế GDNN
enum PriorityObject {
  NONE
  CON_THUONG_BINH_LIET_SI
  DAN_TOC_THIEU_SO
  HO_NGHEO
  KHUYET_TAT
  KHAC
}

// ==========================================
// ADMISSION PROFILE (Hồ sơ đăng ký xét tuyển)
// Mỗi hồ sơ = 1 thí sinh đăng ký 1 Ngành + 1 Hệ đào tạo trong 1 Đợt cụ thể.
// Thí sinh có thể nộp NHIỀU bộ hồ sơ độc lập (không có khái niệm nguyện vọng
// xếp hạng) — mỗi hồ sơ xét duyệt riêng, không loại trừ lẫn nhau.
// ==========================================
model AdmissionProfile {
  id                       Int               @id @default(autoincrement())
  applicationCode          String            @unique // "HS2026-0001"

  // --- Ngành + Hệ đào tạo + Đợt tuyển sinh đăng ký (gộp qua 1 khóa ngoại
  // để tránh lệch dữ liệu giữa campaignId/majorId/trainingType riêng lẻ) ---
  admissionCampaignMajorId Int
  admissionCampaignMajor   AdmissionCampaignMajor @relation(fields: [admissionCampaignMajorId], references: [id])

  // --- Trạng thái & phương thức xét ---
  status              ApplicationStatus @default(REGISTERED)
  admissionType       AdmissionType     @default(ACADEMIC_TRANSCRIPT_GPA)
  educationLevel      EducationLevel    @default(THCS)

  // --- Thông tin cá nhân thí sinh ---
  fullName            String
  identityNumber      String            // CCCD / Mã định danh
  dob                 DateTime          @db.Date
  gender              Gender
  phone               String
  email               String?
  addressDetail       String?
  provinceCode        String?
  province            Province?         @relation(fields: [provinceCode], references: [code])
  wardCode            String?
  ward                Ward?             @relation(fields: [wardCode], references: [code])
  villageId           Int?
  village             Village?          @relation(fields: [villageId], references: [id])

  // --- Thông tin Phụ huynh / Người giám hộ ---
  fatherName          String?
  fatherPhone         String?
  motherName          String?
  motherPhone         String?
  guardianName        String?
  guardianPhone       String?

  // --- Học bạ THCS: điểm TB chung + hạnh kiểm từng năm
  //     (dùng cho admissionType = ACADEMIC_TRANSCRIPT_GPA) ---
  gpa6                Float?
  gpa7                Float?
  gpa8                Float?
  gpa9                Float?
  conduct6            Conduct?
  conduct7            Conduct?
  conduct8            Conduct?
  conduct9            Conduct?
  thcsGradYear        Int?

  // --- Học bạ THPT: điểm TB chung + hạnh kiểm từng năm ---
  gpa10               Float?
  gpa11               Float?
  gpa12               Float?
  conduct10           Conduct?
  conduct11           Conduct?
  conduct12           Conduct?
  thptGradYear        Int?

  // --- Tổ hợp môn đăng ký xét (dùng cho ACADEMIC_TRANSCRIPT_SUBJECT hoặc EXAM_SCORE) ---
  subjectCombinationId Int?
  subjectCombination   SubjectCombination? @relation(fields: [subjectCombinationId], references: [id])

  // --- Điểm thi theo môn: dùng khi admissionType = EXAM_SCORE ---
  examScores          ExamScore[]

  // --- Điểm học bạ theo môn (chỉ 3 môn trong tổ hợp, theo từng năm áp dụng):
  //     dùng khi admissionType = ACADEMIC_TRANSCRIPT_SUBJECT ---
  transcriptSubjectScores TranscriptSubjectScore[]

  totalExamScore      Float?            // Điểm tổng đã tính theo nguồn tương ứng (cache)

  // --- Ưu tiên theo quy chế GDNN ---
  priorityRegion      PriorityRegion?
  priorityObject      PriorityObject?   @default(NONE)
  priorityScore       Float?            @default(0) // auto-fill từ PriorityRule, cho phép override có ghi log

  // --- Tuyển thẳng ---
  isDirectAdmission   Boolean           @default(false)
  directReason        DirectAdmissionReason?

  scoreCalculated     Float?            // Điểm hệ thống tự tính (đã gồm ưu tiên)
  note                String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  documents           AdmissionDocument[]
  statusLogs          AdmissionStatusLog[]

  // --- Liên kết ngược sang Student (chỉ có giá trị khi status = ENROLLED) ---
  studentId           Int?              @unique
  student             Student?          @relation(fields: [studentId], references: [id])

  // Chống 1 thí sinh nộp trùng nhiều hồ sơ cùng ngành + hệ trong cùng 1 đợt
  @@unique([admissionCampaignMajorId, identityNumber])
  @@index([identityNumber]) // tra cứu "CCCD này đã từng nộp hồ sơ đợt nào" trên toàn hệ thống
  @@map("admission_profiles")
}

// Điểm thi theo từng môn — hỗ trợ tổ hợp môn linh hoạt (A, A1, D...)
model ExamScore {
  id                  Int               @id @default(autoincrement())
  admissionProfileId  Int
  subjectCode         String            // MATH, LITERATURE, ENGLISH, PHYSICS, CHEMISTRY, BIOLOGY...
  score               Float

  admissionProfile    AdmissionProfile  @relation(fields: [admissionProfileId], references: [id], onDelete: Cascade)

  @@unique([admissionProfileId, subjectCode])
  @@map("exam_scores")
}

// Điểm học bạ theo từng môn trong tổ hợp xét tuyển, theo từng năm học.
// Chỉ nhập đúng các môn nằm trong subjectCombination đã chọn (validate ở tầng
// ứng dụng), cho các năm mà transcriptScoreMethod của AdmissionCampaignMajor
// yêu cầu (LAST_YEAR_ONLY: 1 năm / AVERAGE_ALL_YEARS: đủ 4 năm hoặc 3 năm).
model TranscriptSubjectScore {
  id                 Int              @id @default(autoincrement())
  admissionProfileId Int
  gradeLevel         Int              // 6,7,8,9 (THCS) hoặc 10,11,12 (THPT)
  subjectCode        String
  score              Float

  admissionProfile   AdmissionProfile @relation(fields: [admissionProfileId], references: [id], onDelete: Cascade)

  @@unique([admissionProfileId, gradeLevel, subjectCode])
  @@map("transcript_subject_scores")
}

// Lịch sử duyệt/chuyển trạng thái hồ sơ — audit trail bắt buộc theo quy chế
model AdmissionStatusLog {
  id                  Int               @id @default(autoincrement())
  admissionProfileId  Int
  fromStatus          ApplicationStatus?
  toStatus            ApplicationStatus

  // Cho phép null khi hệ thống tự động chuyển trạng thái (vd: auto APPROVED
  // theo cutoffScore) — không phải lúc nào cũng có 1 user thật thực hiện thao tác
  byUserId            Int?
  isSystem            Boolean           @default(false)
  reason              String?
  createdAt           DateTime          @default(now())

  admissionProfile    AdmissionProfile  @relation(fields: [admissionProfileId], references: [id], onDelete: Cascade)
  byUser              User?             @relation(fields: [byUserId], references: [id])

  @@map("admission_status_logs")
}

// ==========================================
// TÀI LIỆU ĐÍNH KÈM THEO HỒ SƠ ĐĂNG KÝ
// ==========================================
model AdmissionDocument {
  id                   Int                @id @default(autoincrement())
  admissionProfileId   Int
  documentConfigItemId Int
  fileUrl              String
  fileName             String
  fileSize             Int

  status               DocumentStatus     @default(PENDING)
  rejectionReason      String?
  verifiedAt           DateTime?
  verifiedByUserId     Int?
  verifiedByUser       User?              @relation(fields: [verifiedByUserId], references: [id])

  // Khi thí sinh tải lại giấy tờ bị REJECTED, bản cũ set isLatest = false
  // thay vì để nhiều bản PENDING/REJECTED chồng chéo cùng 1 loại giấy tờ
  isLatest             Boolean            @default(true)

  uploadedAt           DateTime           @default(now())

  admissionProfile     AdmissionProfile   @relation(fields: [admissionProfileId], references: [id], onDelete: Cascade)
  documentConfigItem   DocumentConfigItem @relation(fields: [documentConfigItemId], references: [id])

  @@map("admission_documents")
}

// Phương thức xét tuyển — tách rõ 3 nhánh học bạ/điểm thi để mỗi nhánh có
// công thức tính điểm và bộ dữ liệu đầu vào riêng
enum AdmissionType {
  ACADEMIC_TRANSCRIPT_SUBJECT // Xét học bạ theo tổ hợp 3 môn cụ thể
  ACADEMIC_TRANSCRIPT_GPA     // Xét học bạ theo điểm TB chung + hạnh kiểm từng năm
  EXAM_SCORE                  // Xét điểm thi (Vào lớp 10 hoặc THPT QG) theo tổ hợp môn
  DIRECT                      // Xét tuyển thẳng (Theo quy chế GDNN)
}

enum EducationLevel {
  THCS // Tốt nghiệp THCS (đối tượng tuyển sinh hệ 9+)
  THPT // Tốt nghiệp THPT
}

// Loại hình / Trình độ đào tạo đăng ký
enum TrainingType {
  DUAL_PROGRAM_9PLUS      // Hệ 9+ (Văn hóa THPT + Trung cấp Nghề)
  VOCATIONAL_INTERMEDIATE // Trung cấp Nghề đơn thuần
  VOCATIONAL_ELEMENTARY   // Sơ cấp Nghề (dưới 1 năm)
  CONTINUING_EDUCATION    // Đào tạo thường xuyên / Chuyên đề ngắn hạn
}

enum DocumentStatus {
  PENDING   // Mới tải lên
  APPROVED  // Phòng Đào tạo đã duyệt
  REJECTED  // Giấy tờ mờ, sai thông tin... cần tải lại
}

// Chuẩn hóa lý do tuyển thẳng để thống kê được theo quy định
enum DirectAdmissionReason {
  HSG_QUOC_GIA        // Giải học sinh giỏi quốc gia
  HSG_CAP_TINH        // Giải học sinh giỏi cấp tỉnh
  CHUNG_CHI_NGHE      // Có chứng chỉ nghề phù hợp
  CON_DIEN_CHINH_SACH // Con diện chính sách theo quy chế GDNN
  KHAC                // Lý do khác (ghi rõ ở note)
}

// ==========================================
// CẤU HÌNH ĐIỂM ƯU TIÊN
// Thay vì nhập tay priorityScore trên từng hồ sơ (dễ lệch giữa các thí sinh
// cùng diện ưu tiên), điểm cộng được cấu hình tập trung theo năm học,
// hệ thống auto-fill, cho override có ghi log lý do.
// ==========================================
model PriorityRule {
  id             Int             @id @default(autoincrement())
  academicYearId Int
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  priorityRegion PriorityRegion?
  priorityObject PriorityObject?
  bonusScore     Float

  @@unique([academicYearId, priorityRegion, priorityObject])
  @@map("priority_rules")
}

// ==========================================
// GHI NHẬN NHU CẦU KHI CHƯA CÓ ĐỢT TUYỂN PHÙ HỢP
// Dùng khi tư vấn viên đã tư vấn ngành cho học sinh nhưng hiện chưa có
// AdmissionCampaignMajor nào đang OPEN cho ngành/hệ đó — tránh mất data nhu cầu,
// dùng để gọi lại / thông báo khi có đợt mới mở.
// ==========================================
model AdmissionInterest {
  id             Int          @id @default(autoincrement())
  fullName       String
  phone          String
  identityNumber String?
  majorId        Int
  trainingType   TrainingType
  note           String?
  notifiedAt     DateTime?    // đã báo cho HS khi có đợt mới mở chưa
  createdAt      DateTime     @default(now())

  major          Major        @relation(fields: [majorId], references: [id])

  @@map("admission_interests")
}

// ==========================================
// STUDENT (Định danh học sinh chính thức — KHÔNG lặp dữ liệu gia đình/địa chỉ,
// các thông tin đó lấy qua admissionProfile để tránh trùng & lệch dữ liệu)
//
// QUAN TRỌNG: Student + User CHỈ được tạo tại thời điểm AdmissionProfile
// chuyển sang status = ENROLLED (đã đối chiếu hồ sơ giấy xong), KHÔNG tạo
// sớm hơn ở APPROVED hay CONFIRMED — tránh rác dữ liệu nếu hồ sơ giấy sai lệch
// hoặc thí sinh đổi ý sau khi đã APPROVED/CONFIRMED.
// ==========================================
enum StudentStatus {
  STUDYING   // Đang theo học chính thức
  SUSPENDED  // Bảo lưu
  DROPPED    // Đã thôi học
  GRADUATED  // Đã tốt nghiệp
}

model Student {
  id                  Int               @id @default(autoincrement())
  studentCode         String            @unique // "SV2026001"
  identityNumber      String            @unique // CCCD

  userId              Int               @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Thông tin phân luồng & đào tạo
  batchId             Int?
  batch               Batch?            @relation(fields: [batchId], references: [id])
  majorId             Int?
  major               Major?            @relation(fields: [majorId], references: [id])
  classId             Int?
  class               Class?            @relation(fields: [classId], references: [id])

  educationLevel      EducationLevel    @default(THCS)
  status              StudentStatus     @default(STUDYING)
  enrollmentDate      DateTime?         @db.Date
  graduationDate      DateTime?         @db.Date

  // Thông tin cá nhân hiện hành — có thể thay đổi độc lập với hồ sơ tuyển sinh gốc
  fullName            String
  email               String?
  gender              Gender?
  dob                 DateTime?         @db.Date
  phone               String?
  avatarUrl           String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Mối quan hệ
  // -> Địa chỉ, thông tin cha mẹ: xem qua admissionProfile.province/ward/village/fatherName...
  admissionProfile    AdmissionProfile?
  gradeStudents       GradeStudent[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]
  assessments         Assessment[]

  @@map("students")
}

// ==========================================
// TÀI LIỆU SỐ HÓA HỒ SƠ NHẬP HỌC
// ==========================================
model DocumentConfig {
  id                  Int                  @id @default(autoincrement())
  name                String               // "Hồ sơ nhập học Hệ 9+", "Hồ sơ nhập học Cao đẳng"
  startDate           DateTime             @default(now())

  // Gắn checklist đúng theo đợt tuyển sinh / hệ đào tạo / loại hình
  admissionCampaignId Int?
  admissionCampaign   AdmissionCampaign?   @relation(fields: [admissionCampaignId], references: [id])
  educationLevel      EducationLevel?
  trainingType        TrainingType?

  items               DocumentConfigItem[]

  @@map("document_configs")
}

model DocumentConfigItem {
  id               Int              @id @default(autoincrement())
  documentConfigId Int
  name             String           // CCCD mặt trước, CCCD mặt sau, Bằng tốt nghiệp THCS, Học bạ...
  code             String?          // 'CCCD_FRONT', 'DIPLOMA_THCS'...
  required         Boolean?         @default(true)
  sortOrder        Int?

  documentConfig     DocumentConfig    @relation(fields: [documentConfigId], references: [id])
  admissionDocuments AdmissionDocument[]

  @@map("document_config_items")
}
